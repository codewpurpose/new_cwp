# CodeWithPurpose — environment variables.
#
# Copy this file to `.env.local` and fill in the values to switch on student
# accounts and the leaderboard. Leave them blank (or delete the file) and the
# whole site still works: progress stays local-first on each device.
#
# AUTH is handled by Clerk; the DATABASE + leaderboard by Supabase.
# See docs/SUPABASE_SETUP.md for the full step-by-step.

# --- Clerk (authentication) -------------------------------------------------
# Clerk dashboard -> API keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# No webhook secret is needed. The account welcome email is sent by
# /api/account-welcome/, which authenticates the caller with their own Clerk
# session (CLERK_SECRET_KEY above) rather than a signed webhook payload.

# --- Supabase (database + leaderboard) --------------------------------------
# Supabase dashboard -> Settings -> API.
#   Project URL           -> NEXT_PUBLIC_SUPABASE_URL
#   Project API keys: anon -> NEXT_PUBLIC_SUPABASE_ANON_KEY  (the "publishable"/anon key)
# The anon key is meant to be public and safe in the browser; row-level security
# in supabase/schema.sql is what protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase dashboard -> Settings -> API -> service_role (the "secret" key).
# Server-only. /api/subscribe/ uses it to record newsletter sign-ups, which are
# anonymous and so have no Clerk token for row-level security to check.
#
# This key BYPASSES EVERY POLICY, so three rules:
#   - No NEXT_PUBLIC_ prefix. That would bundle it into the browser, and its
#     absence is what makes importing lib/supabase/server.ts from a client
#     component a build error.
#   - Never a real value in this file. This one is committed; .env / .env.local
#     are gitignored and are where the actual secret goes.
#   - Leave it blank and nothing breaks — sign-ups fall back to Resend only.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (newsletter) ----------------------------------------------------
# Powers the email popup on Koda, the koala mascot. Independent of the two
# services above: with only these three set, sign-up works and nothing else
# changes. Without them, the popup says sign-up isn't switched on yet.
#
# Resend dashboard -> API Keys. Server-only — no NEXT_PUBLIC_ prefix, so it is
# never bundled into the browser. Sending permission is all it needs.
RESEND_API_KEY=

# Resend dashboard -> Audiences. Not a secret, just which list subscribers join.
# Optional: subscribers are recorded in Supabase either way, so leaving this
# blank means the welcome email still sends and Resend's own audience simply
# stays empty. Set it when you want to send a campaign from Resend.
RESEND_AUDIENCE_ID=

# Any address on the domain registered in Resend — for us, the root
# codewithpurpose.org. NOT send.codewithpurpose.org: that subdomain only holds
# the bounce return-path records Resend adds when you register the root, and
# using it as a From address fails with "domain is not verified".
#
# The mailbox doesn't have to exist; DKIM authorises the send and replies are
# routed to team@codewithpurpose.org, which is a real Google Workspace inbox.
EMAIL_FROM="CodeWithPurpose <hello@codewithpurpose.org>"

